# SQL Server connection string
SQL_SERVER_URL=sqlserver://username:password@localhost:1433?database=prims

# Secret for signing JWT tokens; use a long random value in real environments
JWT_SECRET=replace-with-a-long-random-secret

# Secret for the short-lived PDF view-session token (BE-08).
# Kosongkan untuk memakai JWT_SECRET; disarankan diisi nilai berbeda supaya
# token viewer yang bocor lewat URL stream tidak terkait dengan token API.
VIEW_TOKEN_SECRET=

# CIDR reverse proxy yang boleh mengisi header X-Forwarded-For / X-Real-IP
# (dipakai c.ClientIP() untuk kolom ip_address audit trail, US-10-BE).
# Pisahkan dengan koma. Kosongkan bila tidak ada proxy: IP koneksi langsung
# yang dipakai, sehingga header palsu dari klien tidak bisa memalsukan audit.
TRUSTED_PROXIES=

# URL publik PRIMS yang dicetak pada stempel watermark PDF unduhan (US-11-BE).
# Kosongkan untuk memakai https://prims.pusri.co.id.
PRIMS_PUBLIC_URL=

# Optional integration-test connections
AUTH_TEST_SQL_SERVER_URL=
SEED_TEST_SQL_SERVER_URL=
